---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import redsocial from "@images/redsocial.png";
import ShopHome from "@images/ShopHome.webp";
import burgerqueen from "@images/burgerqueen.jpg";
import poke from "@images/poke.jpg";

import "@styles/_projects.scss";
import "@styles/_responsive.scss";
---

<Layout activePage="projects">
  <section class="projects">
    <div class="projects__bio-image">
      <h1 class="text-secondary">Mis proyectos</h1>
    </div>

    <div class="projects__items">
      <div class="projects__item">
        <Image src={redsocial} alt="My Project" />
        <div class="projects__btns">
          <a
            href="https://lim-015-social-network.vercel.app/"
            class="projects__btn"
          >
            <i class="fas fa-eye"></i> Preview
          </a>
          <a
            href="https://github.com/makemile/makemile.github.io-LIM015-social-network"
            class="projects__btn"
          >
            <i class="fab fa-github"></i> Github
          </a>
        </div>
      </div>
      <div class="projects__item">
        <Image src={ShopHome} alt="My Project" />
        <div class="projects__btns">
          <a href="https://shopping-fashion.vercel.app" class="projects__btn">
            <i class="fas fa-eye"></i> Preview
          </a>
          <a
            href="https://github.com/makemile/shopping-fashion"
            class="projects__btn"
          >
            <i class="fab fa-github"></i> Github
          </a>
        </div>
      </div>
      <div class="projects__item">
        <Image src={poke} alt="My Project" />
        <div class="projects__btns">
          <a
            href="https://makemile.github.io/LIM015-data-lovers/src/"
            class="projects__btn"
          >
            <i class="fas fa-eye"></i> Preview
          </a>
          <a
            href="https://github.com/makemile/LIM015-data-lovers"
            class="projects__btn"
          >
            <i class="fab fa-github"></i> Github
          </a>
        </div>
      </div>
      <div class="projects__item">
        <Image src={burgerqueen} alt="My Project" />
        <div class="projects__btns">
          <a href="#!" class="projects__btn">
            <i class="fas fa-eye"></i> Preview
          </a>
          <a
            href="https://github.com/makemile/LIM015-burger-queen/tree/subrama"
            class="projects__btn"
          >
            <i class="fab fa-github"></i> Github
          </a>
        </div>
      </div>
    </div>

    <div class="social-icons">
      <a href="https://github.com/makemile?tab=repositories">
        <i class="fab fa-github fa-2x"></i>
      </a>
      <a href="http://www.linkedin.com/in/kengyamoncada">
        <i class="fa-brands fa-linkedin fa-2x"></i>
      </a>
    </div>
  </section>
</Layout>
